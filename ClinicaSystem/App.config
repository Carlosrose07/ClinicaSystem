<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<startup>
		<supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2" />
	</startup>

	<!--
      Cadena de conexión a SQL Server. Antes estaba fija dentro de ConexionDB.cs;
      ahora vive aquí para poder cambiarla (otra PC, otro servidor) sin recompilar.
      Si instalas el sistema en otra máquina, solo tienes que editar el "Server=..."
      de este archivo (que queda junto al .exe en bin\Debug o bin\Release).
    -->
	<connectionStrings>
		<add name="ClinicaDB"
             connectionString="Server=DESKTOP-P6M7LS4\SQLEXPRESS;Database=ClinicaDB;Integrated Security=True;TrustServerCertificate=True;"
             providerName="System.Data.SqlClient" />
	</connectionStrings>
</configuration>